# ===================================================
# Dockerfile: Next.js Frontend (Production-Ready)
# ===================================================

FROM node:22-alpine AS builder

WORKDIR /app

# Copy root configurations
COPY package.json tsconfig.base.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/web/tsconfig.json ./apps/web/
COPY apps/web/next.config.mjs apps/web/tailwind.config.ts apps/web/postcss.config.mjs ./apps/web/

# Install dependencies
RUN npm install --workspace=apps/web

# Ensure public dir exists and copy source
RUN mkdir -p ./apps/web/public
COPY apps/web/public ./apps/web/public
COPY apps/web/src ./apps/web/src

# Build Next.js
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace=apps/web

# ---------------------------------------------------
# Production Runner
# ---------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/web/next.config.mjs ./apps/web/

RUN npm install --omit=dev --workspace=apps/web

COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/apps/web/public ./apps/web/public

EXPOSE 3000

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

CMD ["npm", "run", "start:web"]
