# ==========================================
# Production Configuration: RAG Native vs Live Data
# ==========================================

# Server & Environment
APP_ENV=development
APP_PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_live_data
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# Cache & Session (Redis)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
CAG_SEMANTIC_THRESHOLD=0.92

# LLM Providers (OpenAI, Anthropic, or Gemini)
# Provider choices: openai | anthropic | gemini | mock (for offline / CI test mode)
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=sk-mock-or-real-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Embedding Model
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Security & Multi-Tenancy
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-for-production
DEFAULT_TENANT_ID=tenant_default_production
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Live Connectors (OAuth & API Keys)
# Set to 'mock' or leave empty for offline Sandbox simulation mode
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

NOTION_API_KEY=
NOTION_DATABASE_ID=

JIRA_HOST=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-native-live-data
